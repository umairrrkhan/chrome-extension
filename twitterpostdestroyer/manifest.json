{
  "manifest_version": 3,
  "name": "Twitter Post Destroyer",
  "version": "1.1.0",
  "description": "A tiny stickman. A big arsenal. Clear unwanted posts from your view with playful physics and destruction.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitter Post Destroyer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "engine.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Umair Khan"
}
